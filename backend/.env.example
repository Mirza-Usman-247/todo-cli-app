# Todo API Backend Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ============================================
# Full connection string for Neon PostgreSQL
# Format: postgresql+asyncpg://user:password@host/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/neondb?sslmode=require

# Individual database connection parameters (alternative to DATABASE_URL)
DATABASE_HOST=your-project.neon.tech
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=neondb
DATABASE_PORT=5432

# ============================================
# AUTHENTICATION (Better Auth)
# ============================================
# Secret key for signing session tokens (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl

# Backend URL (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:8000

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend URL for CORS origin (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment mode: development, staging, production
ENVIRONMENT=development

# Debug mode (enables detailed error messages)
DEBUG=true

# API version prefix
API_V1_PREFIX=/api/v1

# ============================================
# AI CHATBOT CONFIGURATION (Google Gemini)
# ============================================
# Google Gemini API Key (get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (options: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash-exp)
MODEL_ID=gemini-1.5-flash

# OpenAI-compatible base URL for Gemini API
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# MCP (Model Context Protocol) server configuration
# MCP servers provide tools for the AI agent (e.g., todo management)
MCP_SERVER_CONFIG_PATH=./src/mcp/config.json
