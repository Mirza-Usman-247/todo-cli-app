.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.*

# Database
*.db
*.sqlite3

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# UV cache
.uv/
